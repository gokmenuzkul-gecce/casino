# ===== Aurora Platform - Development Environment =====
NODE_ENV=development
APP_NAME=Aurora
APP_URL=http://localhost:3000
ENGINE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# --- Database ---
POSTGRES_USER=aurora
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aurora
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aurora:aurora_dev_pass@localhost:5432/aurora?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / Security ---
JWT_ACCESS_SECRET=generate_a_long_random_secret
JWT_REFRESH_SECRET=generate_a_long_random_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
SESSION_COOKIE_DOMAIN=localhost
TOTP_ISSUER=Aurora
ENCRYPTION_KEY=generate_32_byte_random_key
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2

# --- Mail (dev: Mailpit) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAIL_TRANSPORT=smtp
MAIL_FROM="Aurora <no-reply@aurora.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- SMS ---
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=

# --- Platform mode: demo | live ---
# demo => internal wallet, fake money, no real provider calls
# live => real PSP + game aggregator credentials required
PLATFORM_MODE=demo
CURRENCY=TRY
CURRENCY_SYMBOL=TRY_SYMBOL

# ===== Provider integration layer (fill when licence is ready) =====
# --- Game aggregator (slot/live/table content) ---
# GAME_AGGREGATOR=gregmorn => use the Gregmorn Hub block below instead.
GAME_AGGREGATOR=none
GAME_AGGREGATOR_BASE_URL=
GAME_AGGREGATOR_API_KEY=
GAME_AGGREGATOR_SECRET=
GAME_AGGREGATOR_MERCHANT_ID=
GAME_AGGREGATOR_CALLBACK_SECRET=

# --- Gregmorn Hub (GAME_AGGREGATOR=gregmorn) ---
# Stage and prod are separate deployments: separate logins, secret keys and IP
# allowlists. Start on stage; move to prod only after acceptance.
# Requires an inbound callback path to be reachable from Gregmorn:
#   POST {API_PUBLIC_URL}/webhooks/aggregator/gregmorn/wallet
# Currency callback URLs are configured per currency on the Gregmorn side.
GREG_MORN_OFFICE_URL=https://office-api-dev.gregmorn.org
GREG_MORN_CLIENT_URL=https://client-api-dev.gregmorn.org
GREG_MORN_LOGIN=
GREG_MORN_PASSWORD=
# Merchant secret key: signs openGame/freespinsInfo and verifies wallet callbacks.
GREG_MORN_SECRET_KEY=
# API user id issued by Gregmorn; sent as user_id on launch.
GREG_MORN_USER_ID=
GREG_MORN_CURRENCY=TRY

# --- BetSkilla white-label hub (GAME_AGGREGATOR=betskilla|xenzora|kingsbet) ---
# The operator brand host fronts the whole platform: operator session, game
# catalogue and session launch. Set GAME_AGGREGATOR=betskilla and point the
# base URL at the brand (xenzora.com or kingsbet365.com). Credentials are the
# aggregator-issued operator login, not a player account.
BETSKILLA_BASE_URL=https://xenzora.com
BETSKILLA_LOGIN=
BETSKILLA_PASSWORD=
# Must match CURRENCY: the wallet bridge settles in the player's currency, and a
# session opened in another one is refused rather than silently mispriced.
BETSKILLA_CURRENCY=TRY
# Signs the hub's seamless-wallet callbacks. Empty disables the wallet bridge,
# so game sessions fall back to the hub's own balance instead of the player's.
BETSKILLA_CALLBACK_SECRET=

# --- loginxgamesapi / GitSlotPark Seamless Wallet API v2 (GAME_AGGREGATOR=loginx) ---
# One contract fronting four vendor credential sets, each on its own host. Every
# vendor needs an APITOKEN (catalogue + launch); the AGENTID and SECRETKEY
# authorise the wallet callbacks and are required before any money can settle.
# A vendor missing them can still have its catalogue imported but is not treated
# as live.
#
# hosts default to apiv2.gitslotpark.com (Pragmatic Play),
# pgapi.gitslotpark.com (PG Soft), api.amaticgame.net (Amatic) and
# apiv2.apilx.com (Amusnet); override with LOGINX_<VENDOR>_HOST if issued
# different ones.
LOGINX_CURRENCY=TRY
LOGINX_PRAGMATIC_AGENTID=
LOGINX_PRAGMATIC_APITOKEN=
LOGINX_PRAGMATIC_SECRETKEY=
LOGINX_PGSOFT_AGENTID=
LOGINX_PGSOFT_APITOKEN=
LOGINX_PGSOFT_SECRETKEY=
LOGINX_AMATIC_AGENTID=
LOGINX_AMATIC_APITOKEN=
LOGINX_AMATIC_SECRETKEY=
LOGINX_AMUSNET_AGENTID=
LOGINX_AMUSNET_APITOKEN=
LOGINX_AMUSNET_SECRETKEY=
# Base path the provider posts the five callbacks to (GetBalance, BetWin,
# Withdraw, Deposit, RollbackTransaction). The operator registers
# <API_PUBLIC_URL><WALLET_CALLBACK_BASE> with the provider.
WALLET_CALLBACK_BASE=/webhooks/callback

# --- Payment service provider (deposit/withdrawal) ---
PSP_PROVIDER=none
PSP_BASE_URL=
PSP_API_KEY=
PSP_SECRET_KEY=
PSP_MERCHANT_ID=
PSP_WEBHOOK_SECRET=
PSP_CURRENCIES=TRY

# --- Crypto payments ---
CRYPTO_PROVIDER=none
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=

# --- KYC / AML ---
KYC_PROVIDER=none
KYC_BASE_URL=
KYC_API_KEY=
KYC_WEBHOOK_SECRET=

# --- Risk / fraud ---
RISK_PROVIDER=none
RISK_API_KEY=

# --- Affiliate ---
AFFILIATE_ENABLED=true
AFFILIATE_COOKIE_DAYS=30

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@aurora.local
ADMIN_PASSWORD=change_me_on_first_boot
ADMIN_USERNAME=superadmin

# --- Feature flags ---
FEATURE_SPORTSBOOK=true
FEATURE_LIVE_CASINO=true
FEATURE_TOURNAMENTS=true
FEATURE_VIP=true
FEATURE_AFFILIATES=true
FEATURE_CRYPTO=true
FEATURE_KYC=true
